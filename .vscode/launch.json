{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Full-Stack Node Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "port": 9229,
      "console": "integratedTerminal",
      "env": {
        "PORT": "3000"
      }
    },
    {
      "name": "Run FastAPI Backend (Python)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "justMyCode": true
    }
  ]
}
